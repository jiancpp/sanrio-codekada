# ==========================================
# RECENT ACTIVITY ROUTES
# ==========================================

### Post Activity (e.g., Logged BP)
POST http://localhost:5001/api/system/post-activity
x-system-key: your_super_secret_key_here
Content-Type: application/json

{
    "userId": "{{lolaId}}",
    "familyId": "{{familyId}}",
    "type": "LOG_VITAL",
    "description": "Log vitals today"
}

### Get Activity (One per person for the family)
GET http://localhost:5001/api/system/get-activity/{{familyId}}
Authorization: Bearer {{token}}

# ==========================================
# MONTHLY SUMMARY ROUTES
# ==========================================

### Generate Summary (Run this first to populate DB)
# Note: Ensure familyId exists in your DB
POST http://localhost:5001/api/system/generate-summary
x-system-key: your_super_secret_key_here
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "familyId": "{{familyId}}",
    "month": 5,
    "year": 2026
}

### Get Monthly Summary
GET http://localhost:5001/api/system/get-summary?familyId={{familyId}}&month=5&year=2026
Authorization: Bearer {{token}}

# ==========================================
# LAB TESTS (With New Items Array)
# ==========================================

### Create Lab Test with Structured Items
POST http://localhost:5001/api/lab-tests/add
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "familyCode": "{{familyCode}}",
    "member": "{{lolaId}}",
    "testName": "CBC",
    "testDate": "2026-05-06T08:00:00Z",
    "findingsSummary": "Cholesterol is slightly elevated compared to last March."
}